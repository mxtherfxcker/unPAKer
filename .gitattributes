# Set default behavior to automatically normalize line endings
* text=auto

# Force LF for source files
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.c text eol=lf

# Force LF for config files
*.yml text eol=lf
*.yaml text eol=lf
.clang-format text eol=lf
CMakeLists.txt text eol=lf

# Binary files
*.ico binary
*.exe binary
